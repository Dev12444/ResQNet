# Copy to .env and fill in. NEVER commit .env
# Local dev uses SQLite automatically. For prod use Postgres (Supabase/Neon):
#   postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./resqnet.db

# AI providers, tried in order, then rule-based fallback. Leave a key empty to skip that provider.
LLM_PROVIDERS=openai,gemini
EMBED_PROVIDERS=gemini,openai

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODEL=gpt-4.1-nano
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_RPM=300
# Stop calling OpenAI once estimated spend reaches this (USD). 0 = no cap.
OPENAI_BUDGET_USD=8

# Google AI Studio key — https://aistudio.google.com/apikey (backup provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite,gemini-3.6-flash
GEMINI_RPM=12
GEMINI_THINKING_LEVEL=minimal
GEMINI_EMBED_MODEL=gemini-embedding-001
# Set to false to force the rule-based fallback (offline demo / rate limits)
AI_ENABLED=true

# Telegram bot (create via @BotFather). Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORITY_CHAT_ID=
TELEGRAM_RESPONDER_CHAT_ID=

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Optional: also allow origins matching this regex (Vercel previews), e.g. ^https://[a-z0-9-]*resqnet[a-z0-9-]*\.vercel\.app$
CORS_ORIGIN_REGEX=

# Fill an EMPTY database with the seed data on startup (never wipes anything)
SEED_ON_STARTUP=true

# Demo SLA values (seconds)
SLA_P1_DISPATCH_SEC=120
SLA_P2_DISPATCH_SEC=300
SLA_NO_UPDATE_SEC=600
ESCALATION_TICK_SEC=15
# Auto-escalate an undispatched incident after this many missed dispatch SLAs (0 = only by a dispatcher click)
AUTO_ESCALATE_AFTER_BREACHES=2

# BE2: persistent AI cache (survives restarts; run scripts/warm_cache.py before the demo). Empty = disabled.
LLM_CACHE_PATH=.cache/llm_cache.sqlite3
