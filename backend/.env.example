# Copy to .env and fill in. NEVER commit .env
# Local dev uses SQLite automatically. For prod use Postgres (Supabase/Neon):
#   postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./resqnet.db

# Google AI Studio key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004
# Set to false to force the rule-based fallback (offline demo / rate limits)
AI_ENABLED=true

# Telegram bot (create via @BotFather). Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORITY_CHAT_ID=
TELEGRAM_RESPONDER_CHAT_ID=

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Demo SLA values (seconds)
SLA_P1_DISPATCH_SEC=120
SLA_P2_DISPATCH_SEC=300
SLA_NO_UPDATE_SEC=600
ESCALATION_TICK_SEC=15
