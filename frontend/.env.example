# ResQNet frontend configuration. Two variables, neither of them a secret.
# lib/api.ts is the only file that reads them; no component builds a URL.

# The backend. Required in production: a build without it has no API to call
# and every screen says so, naming this variable. There is no localhost
# fallback in production on purpose — in a browser localhost means the
# visitor's own machine, which fails while looking like the API is down.
NEXT_PUBLIC_API_URL=https://resqnet-api-0jmr.onrender.com

# Demo mode, opt-in. ONLY the exact string "true" enables it; missing, empty
# or anything else means the real backend. It is this way round because
# forgetting a variable on a hosting dashboard is the likeliest mistake, and
# the old default punished it by silently serving invented incidents.
NEXT_PUBLIC_USE_MOCK=false

# What happens when a live call fails, so nobody has to guess:
#   - endpoint exists, call fails  -> last good response if there is one,
#                                     otherwise an explicit "no data" state.
#                                     Never fixtures dressed as real records.
#   - endpoint is not in the contract (shelters, pulse, district situation,
#     logs, ground-truth, weather) -> fixtures, badged DEMO wherever shown.
